# 放在 http 块内。先签发域名证书，再启用此站点。
limit_req_zone $binary_remote_addr zone=identity_login:10m rate=10r/m;
server {
    listen 80;
    listen [::]:80;
    server_name identity.meta-gravity.com;
    location = /WW_verify_HVb3TsF9mFBIsqUv.txt {
        root /var/www/mg-identity/public;
        default_type text/plain;
        try_files $uri =404;
    }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/mg-identity/public;
        try_files $uri =404;
    }
    location / { return 308 https://identity.meta-gravity.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name identity.meta-gravity.com;
    ssl_certificate /etc/letsencrypt/live/identity.meta-gravity.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/identity.meta-gravity.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # 回调包含一次性 code；认证站点不记录请求 URL。
    access_log off;
    client_max_body_size 128k;
    location = /WW_verify_HVb3TsF9mFBIsqUv.txt {
        root /var/www/mg-identity/public;
        default_type text/plain;
        try_files $uri =404;
    }
    location ~ ^/api/auth/(login|zentao/login)$ {
        limit_req zone=identity_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:4200;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:4200;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
