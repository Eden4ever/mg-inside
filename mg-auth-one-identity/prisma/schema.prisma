generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model MailConfig {
  id String @id
  enabled Boolean @default(false)
  host String
  port Int
  security String
  username String
  encryptedPassword String
  fromAddress String
  fromName String
  revision Int @default(1)
  lastTestAt DateTime?
  updatedAt DateTime @updatedAt
}

model User {
  id               String        @id @default(uuid())
  username         String?       @unique
  displayName      String        @unique
  passwordHash     String?
  /// 历史兼容列，不再作为权限来源；对外 role 由统一角色成员关系派生。
  role             String        @default("member")
  status           String        @default("active")
  authSource       String        @default("local")
  avatarUrl        String?
  departmentName   String?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  securityVersion  Int           @default(0)
  mfaEnabled       Boolean       @default(false)
  mfaMethods       String[]      @default([])
  verifiedEmail    VerifiedEmail?
  totpCredential   TotpCredential?
  securityKeys     SecurityKey[]
  authChallenges  AuthChallenge[]
  recoveryCodes   RecoveryCode[]
  sessions         AuthSession[]
  auditLogs        AuditLog[]
  wecomIdentities  WeComIdentity[]
  zentaoIdentities ZentaoIdentity[]
  applications ApplicationUser[]
  roles UserRole[]
}

model ZentaoIdentity {
  id String @id @default(uuid())
  userId String
  server String
  account String
  boundAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([server, account])
  @@unique([userId, server])
}

model Application {
  clientId String @id
  name String
  enabled Boolean @default(true)
  memberships ApplicationUser[]
  roles RoleApplication[]
}

model Role {
  id String @id @default(uuid())
  key String? @unique
  name String
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members UserRole[]
  applications RoleApplication[]
}

model UserRole {
  userId String
  roleId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@index([roleId])
}

model RoleApplication {
  roleId String
  clientId String
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  @@id([roleId, clientId])
  @@index([clientId])
}

model ApplicationUser {
  clientId String
  userId String
  localUserId String?
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
  application Application @relation(fields: [clientId], references: [clientId])
  user User @relation(fields: [userId], references: [id])
  @@id([clientId, userId])
  @@unique([clientId, localUserId])
}

model OidcRecord {
  model String
  id String
  payload Json
  uid String?
  userCode String?
  grantId String?
  expiresAt DateTime
  consumedAt Int?
  @@id([model, id])
  @@index([model, uid])
  @@index([model, userCode])
  @@index([grantId])
  @@index([expiresAt])
}

model DirectorySnapshot {
  id String @id @default(uuid())
  clientId String
  rows Json
  expiresAt DateTime
  @@index([expiresAt])
}

model OidcSessionLink {
  grantId String @id
  sessionId String
  userId String
  clientId String
  @@index([sessionId])
}

model AuthSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  csrfToken  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  securityVersion Int @default(0)
  authMethods String[] @default([])
  verifiedAt DateTime @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model WeComIdentity {
  id             String   @id @default(uuid())
  userId         String
  corpId         String
  externalUserId String
  boundAt        DateTime @default(now())
  lastLoginAt    DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corpId, externalUserId])
  @@unique([userId, corpId])
  @@index([userId])
}

model WeComIdentityRevocation {
  corpId         String
  externalUserId String
  revokedAt      DateTime @default(now())

  @@id([corpId, externalUserId])
}

model VerifiedEmail {
  userId String @id
  address String @unique
  verifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TotpCredential {
  userId String @id
  encryptedSecret String
  lastUsedStep BigInt @default(-1)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityKey {
  id String @id
  userId String
  name String
  publicKey Bytes
  counter BigInt @default(0)
  transports String[] @default([])
  backedUp Boolean @default(false)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuthChallenge {
  id String @id @default(uuid())
  tokenHash String @unique
  browserHash String
  userId String
  purpose String
  firstMethod String
  securityVersion Int
  payload Json @default("{}")
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id String @id @default(uuid())
  userId String
  codeHash String @unique
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model WeComLoginState {
  id               String    @id @default(uuid())
  stateHash        String    @unique
  browserNonceHash String
  returnTo         String    @default("/")
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt, usedAt])
}

model AuditLog {
  id        String            @id @default(uuid())
  actorUserId String?
  actorName String
  actorRole String
  action    String
  targetType String
  targetId  String
  result    String            @default("success")
  detail    Json?
  at        DateTime          @default(now())
  actorUser User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

}
