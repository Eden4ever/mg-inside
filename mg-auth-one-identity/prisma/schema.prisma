generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model MailConfig {
  id String @id
  enabled Boolean @default(false)
  host String
  port Int
  security String
  username String
  encryptedPassword String
  fromAddress String
  fromName String
  revision Int @default(1)
  lastTestAt DateTime?
  updatedAt DateTime @updatedAt
}

model User {
  id               String        @id @default(uuid())
  username         String?       @unique
  displayName      String        @unique
  passwordHash     String?
  /// 历史兼容列，不再作为权限来源；对外 role 由统一角色成员关系派生。
  role             String        @default("member")
  status           String        @default("active")
  authSource       String        @default("local")
  avatarUrl        String?
  departmentName   String?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  securityVersion  Int           @default(0)
  mfaEnabled       Boolean       @default(false)
  mfaMethods       String[]      @default([])
  verifiedEmail    VerifiedEmail?
  totpCredential   TotpCredential?
  securityKeys     SecurityKey[]
  authChallenges  AuthChallenge[]
  recoveryCodes   RecoveryCode[]
  sessions         AuthSession[]
  auditLogs        AuditLog[]
  loginAttempts    LoginAttempt[]
  wecomIdentities  WeComIdentity[]
  zentaoIdentities ZentaoIdentity[]
  applications ApplicationUser[]
  roles UserRole[]
  organizations UserOrganization[]
  managementScopes ScopeAdministrator[]
  scopeGrants ScopeGrant[]
}

model Division {
  id           String       @id @default(uuid())
  parentId     String?
  code         String       @unique
  name         String
  type         String       @default("district")
  level        Int          @default(1)
  standard     Boolean      @default(true)
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  parent       Division?    @relation("DivisionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Division[]   @relation("DivisionTree")
  organizations Organization[]
  managedDivisions DivisionMapping[] @relation("ManagedDivisions")
  hostingZones DivisionMapping[] @relation("HostingZones")
  managementScope ManagementScope?
  @@index([parentId])
  @@index([name])
}

model DivisionMapping {
  zoneId String
  officialId String
  zone Division @relation("ManagedDivisions", fields: [zoneId], references: [id], onDelete: Cascade)
  official Division @relation("HostingZones", fields: [officialId], references: [id], onDelete: Restrict)
  @@id([zoneId, officialId])
  @@index([officialId])
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  creditCode  String    @unique
  type        String    @default("institution")
  divisionId  String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  plaques     OrganizationPlaque[]
  members     UserOrganization[]
  managementScope ManagementScope?
  @@index([divisionId])
  @@index([name])
}

model UserOrganization {
  userId         String
  organizationId String
  isPrimary      Boolean      @default(false)
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([userId, organizationId])
  @@index([organizationId])
}

model OrganizationPlaque {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, name])
}

model ZentaoIdentity {
  id String @id @default(uuid())
  userId String
  server String
  account String
  boundAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([server, account])
  @@unique([userId, server])
}

model Application {
  clientId String @id
  memberships ApplicationUser[]
  roles RoleApplication[]
  scopeApplications ScopeApplication[]
  @@map("ApplicationReference")
}

model ManagementScope {
  id String @id @default(uuid())
  divisionId String? @unique
  organizationId String? @unique
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  administrators ScopeAdministrator[]
  applications ScopeApplication[]
}

model ScopeAdministrator {
  scopeId String
  userId String
  scope ManagementScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([scopeId, userId])
  @@index([userId])
}

model ScopeApplication {
  scopeId String
  clientId String
  scope ManagementScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  grants ScopeGrant[]
  @@id([scopeId, clientId])
  @@index([clientId])
}

model ScopeGrant {
  scopeId String
  clientId String
  userId String
  createdAt DateTime @default(now())
  scopeApplication ScopeApplication @relation(fields: [scopeId, clientId], references: [scopeId, clientId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([scopeId, clientId, userId])
  @@index([userId, clientId])
}

model Role {
  id String @id @default(uuid())
  key String? @unique
  name String
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members UserRole[]
  applications RoleApplication[]
}

model UserRole {
  userId String
  roleId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@index([roleId])
}

model RoleApplication {
  roleId String
  clientId String
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  @@id([roleId, clientId])
  @@index([clientId])
}

model ApplicationUser {
  clientId String
  userId String
  localUserId String?
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
  application Application @relation(fields: [clientId], references: [clientId])
  user User @relation(fields: [userId], references: [id])
  @@id([clientId, userId])
  @@unique([clientId, localUserId])
}

model OidcClient {
  clientId String @id
  redirectUris String[]
  encryptedSecret String
  enabled Boolean @default(true)
  revision Int @default(1)
  registrationId String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OidcRecord {
  model String
  id String
  payload Json
  uid String?
  userCode String?
  grantId String?
  expiresAt DateTime
  consumedAt Int?
  clientId String?
  clientRevision Int?
  @@id([model, id])
  @@index([model, uid])
  @@index([model, userCode])
  @@index([grantId])
  @@index([expiresAt])
  @@index([clientId])
}

model DirectorySnapshot {
  id String @id @default(uuid())
  clientId String
  rows Json
  expiresAt DateTime
  @@index([expiresAt])
}

model OidcSessionLink {
  grantId String @id
  sessionId String
  userId String
  clientId String
  @@index([sessionId])
}

model AuthSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  csrfToken  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  securityVersion Int @default(0)
  authMethods String[] @default([])
  verifiedAt DateTime @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model WeComIdentity {
  id             String   @id @default(uuid())
  userId         String
  corpId         String
  externalUserId String
  boundAt        DateTime @default(now())
  lastLoginAt    DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corpId, externalUserId])
  @@unique([userId, corpId])
  @@index([userId])
}

model WeComIdentityRevocation {
  corpId         String
  externalUserId String
  revokedAt      DateTime @default(now())

  @@id([corpId, externalUserId])
}

model VerifiedEmail {
  userId String @id
  address String @unique
  verifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TotpCredential {
  userId String @id
  encryptedSecret String
  lastUsedStep BigInt @default(-1)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityKey {
  id String @id
  userId String
  name String
  publicKey Bytes
  counter BigInt @default(0)
  transports String[] @default([])
  backedUp Boolean @default(false)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuthChallenge {
  id String @id @default(uuid())
  tokenHash String @unique
  browserHash String
  userId String
  purpose String
  firstMethod String
  securityVersion Int
  payload Json @default("{}")
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id String @id @default(uuid())
  userId String
  codeHash String @unique
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model WeComLoginState {
  id               String    @id @default(uuid())
  stateHash        String    @unique
  browserNonceHash String
  returnTo         String    @default("/")
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt, usedAt])
}

/// 登录尝试流水：成功与失败都追加，作为安全中心「登录历史」的唯一来源。
/// 失败必须在计数事务提交后写入，不能因回滚丢失；账号不存在时 userId 为空但保留输入账号。
model LoginAttempt {
  id          String   @id @default(uuid())
  userId      String?
  username    String
  displayName String?
  result      String
  reason      String?
  source      String
  secondMethod String?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  at          DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([userId, at])
  @@index([username, at])
  @@index([result, at])
}

model AuditLog {
  id        String            @id @default(uuid())
  actorUserId String?
  actorName String
  actorRole String
  action    String
  targetType String
  targetId  String
  result    String            @default("success")
  detail    Json?
  at        DateTime          @default(now())
  actorUser User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

}
