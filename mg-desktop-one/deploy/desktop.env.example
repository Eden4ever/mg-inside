# 仅模板。真实文件在 /opt/mg-desktop/secrets/desktop.env，0600；不得提交或输出。
NODE_ENV=production
HOST=127.0.0.1
PORT=4300
DESKTOP_ORIGIN=https://desktop.meta-gravity.com
DESKTOP_FLOW_KEY=REPLACE_WITH_PERSISTENT_64_HEX
IDENTITY_ENABLED=true
IDENTITY_ISSUER=https://identity.meta-gravity.com
IDENTITY_CLIENT_ID=desktop-one
IDENTITY_CLIENT_SECRET=REPLACE_WITH_REGISTERED_SERVICE_SECRET
# 应用入口、上游和授权配置只在 desktop_applications 表维护。
# 数据库配置位于 services.env，Java 必须配置；启动前由管理账号执行显式应用迁移。
# 迁移命令与注册清单格式见 mg-platform-kernel/docs/application-registration.md。
# SERVICE_DATABASE_URL=postgresql://registry_app:REPLACE@127.0.0.1:15440/mg_services
# SERVICE_ENVIRONMENT=production
