# 仅模板。凭据必须是中心为 files 注册的独立服务身份，不复用桌面服务 secret。
NODE_ENV=production
FILES_HOST=127.0.0.1
FILES_PORT=14350
FILES_STORAGE_DIR=/var/lib/mg-files
FILES_MAX_FILE_BYTES=52428800
FILES_USER_QUOTA_BYTES=1073741824
IDENTITY_ISSUER=https://identity.meta-gravity.com
IDENTITY_CLIENT_ID=files
IDENTITY_CLIENT_SECRET=REPLACE_WITH_REGISTERED_SERVICE_SECRET
