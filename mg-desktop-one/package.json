{
  "name": "mg-desktop-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:server": "node scripts/dev-java.mjs",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p apps/web/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p apps/server/tsconfig.json",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "build:compatibility": "node scripts/build-server.mjs --compatibility",
    "test": "node node_modules/vitest/vitest.mjs run --exclude .runtime/**",
    "test:storage": "node scripts/build-server.mjs --compatibility && node node_modules/tsx/dist/cli.mjs --test scripts/verify-service-storage.ts",
    "test:contract-http": "node scripts/build-server.mjs --compatibility && node scripts/verify-contract-http.mjs",
    "test:applications": "node scripts/verify-application-registration.mjs",
    "test:p0": "node scripts/sync-auth-client.mjs --check && node scripts/verify-p0.mjs",
    "sync:auth": "node scripts/sync-auth-client.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.0",
    "pinia": "2.3.0",
    "vue": "3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.1",
    "esbuild": "0.25.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  }
}
