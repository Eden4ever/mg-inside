POSTGRES_PASSWORD=""
# 将数据库密码进行 URL 编码后填入连接串；不得沿用公开的默认密码。
DATABASE_URL="postgresql://mg_expert:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5437/mg_expert?schema=public"
PORT=4100
HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:5173"
WEB_APP_URL="http://localhost:5173"
# 安全密钥精确站点来源，生产必须 HTTPS；不要包含路径。
WEBAUTHN_ORIGIN="http://localhost:5173"
# 认证配置加密密钥文件需与数据库一起备份，不可提交到仓库。
# AUTH_CONFIG_KEY_FILE="/opt/mg-expert-database/shared/auth-config.key"
# 留空时自动使用 ${VITE_APP_BASE_URL}api；跨域 API 部署时再显式填写完整地址。
VITE_API_BASE_URL=""
VITE_APP_BASE_URL="/"
SESSION_TTL_HOURS=12
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"

# 企业微信扫码登录：四项均配置且显式启用后生效，Secret 只放服务端环境。
WECOM_LOGIN_ENABLED=false
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_APP_SECRET=""
WECOM_REDIRECT_URI="https://your-domain.example/api/auth/wecom/callback"
WECOM_DIRECTORY_SYNC_ENABLED=false
# 自动同步间隔限制为 15 至 1440 分钟；新成员默认创建为只读用户。
WECOM_DIRECTORY_SYNC_INTERVAL_MINUTES=60

# M4 AI：DeepSeek 官方 API。密钥只放服务端环境，不要提交到仓库。
DEEPSEEK_API_KEY=""
# 需显式选择模型，例如 deepseek-v4-flash 或 deepseek-v4-pro；系统不代替业务方选型。
DEEPSEEK_MODEL=""
DEEPSEEK_REQUEST_TIMEOUT_MS=45000
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=5
# 智谱向量化：仅后端读取。正文及检索问题会发送至智谱。
ZHIPU_API_KEY=
