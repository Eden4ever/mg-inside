          "fieldType": "object_list",
          "requirement": "confirm",
          "enumValues": [
            "能力不足",
            "客观限制",
            "体制机制障碍",
            "复合原因"
          ]
        },
        {
          "fieldId": "impact_assessment",
          "label": "影响研判",
          "fieldType": "long_text",
          "requirement": "confirm"
        }
      ]
    },
    {
