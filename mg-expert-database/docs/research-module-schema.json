{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mg-expert-database.local/schema/research-module-schema.json",
  "title": "营商环境指标知识库八模块研究字段定义",
  "description": "各级知识记录契约，x-moduleDefinitions 仅作为三级及明细层级初始模板。",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchRecord",
    "moduleDefinitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "researchRecord": {
      "$ref": "#/$defs/researchRecord"
    },
    "moduleDefinitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/moduleDefinition"
      },
      "description": "体系和层级的当前模块定义。"
    }
  },
  "$defs": {
    "moduleKey": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,99}$"
    },
    "requirement": {
      "type": "string",
      "enum": [
        "confirm",
        "publish",
        "optional"
      ]
    },
    "fieldType": {
      "type": "string",
      "enum": [
        "short_text",
        "long_text",
        "rich_text",
        "number",
        "decimal",
        "percentage",
        "date",
        "enum",
        "reference_list",
        "object_list",
        "organization_contact_list"
      ]
    },
    "fieldDefinition": {
      "type": "object",
      "required": [
        "fieldId",
        "label",
        "fieldType",
        "requirement"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fieldType": {
          "$ref": "#/$defs/fieldType"
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true
        },
        "requiresEvidence": {
          "type": "boolean",
          "default": false
        },
        "allowNotApplicable": {
          "type": "boolean",
          "default": false
        },
        "active": {
          "type": "boolean"
        },
        "inactiveEnumValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fieldType": {
                "const": "enum"
              }
            },
            "required": [
              "fieldType"
            ]
          },
          "then": {
            "required": [
              "enumValues"
            ]
          }
        }
      ]
    },
    "moduleDefinition": {
      "type": "object",
      "required": [
        "moduleKey",
        "displayOrder",
        "name",
        "researchQuestion",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "moduleKey": {
          "$ref": "#/$defs/moduleKey"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "researchQuestion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "fields": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "researchRecord": {
      "type": "object",
      "required": [
        "indicatorVersionId",
        "indicatorNodeId",
        "indicatorLevel",
        "modules"
      ],
      "additionalProperties": false,
      "properties": {
        "indicatorVersionId": {
          "type": "string",
          "minLength": 1
        },
        "indicatorNodeId": {
          "type": "string",
          "minLength": 1
        },
        "indicatorLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "modules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/modulePayload"
          }
        }
      }
    },
    "modulePayload": {
      "type": "object",
      "required": [
        "moduleKey",
        "status",
        "revisionNo",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "moduleKey": {
          "$ref": "#/$defs/moduleKey"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "in_progress",
            "pending_review",
            "confirmed",
            "returned"
          ]
        },
        "revisionNo": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "object",
          "description": "键必须使用该模块 fieldId；服务端按 moduleDefinitions 校验字段类型、必填性和不适用说明。"
        },
        "notApplicableReasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "x-moduleDefinitions": [
    {
      "moduleKey": "portrait",
      "displayOrder": 1,
      "name": "指标画像",
      "researchQuestion": "考什么",
      "fields": [
        {
          "fieldId": "indicator_nature",
          "label": "指标属性",
          "fieldType": "enum",
          "enumValues": [
            "正向指标",
            "逆向指标",
            "中性指标"
          ],
          "requirement": "confirm"
        },
        {
          "fieldId": "assessment_scope",
          "label": "考核对象与范围",
          "fieldType": "long_text",
          "requirement": "confirm",
          "requiresEvidence": true
        },
        {
          "fieldId": "measurement_type",
          "label": "计量方式",
          "fieldType": "enum",
          "enumValues": [
            "比率类",
            "数量类",
            "时长类",
            "评分类",
            "复合类"
          ],
          "requirement": "confirm"
        },
        {
          "fieldId": "assessment_cycle",
          "label": "考核周期",
          "fieldType": "enum",
          "enumValues": [
            "实时",
            "每日",
            "每月",
            "季度",
            "年度",
            "不固定"
          ],
          "requirement": "confirm"
        },
        {
          "fieldId": "time_dimension",
          "label": "时间维度",
          "fieldType": "enum",
          "enumValues": [
            "时点数",
            "时期数",
            "存量",
            "增量",
            "混合"
          ],
          "requirement": "confirm"
        },
        {
          "fieldId": "horizontal_relations",
          "label": "横向联系",
          "fieldType": "long_text",
          "requirement": "optional",
          "allowNotApplicable": true
        },
        {
          "fieldId": "assessment_weight",
          "label": "考核权重",
          "fieldType": "percentage",
          "requirement": "publish",
          "requiresEvidence": true
        },
        {
          "fieldId": "frontier_values",
          "label": "全国前沿值",
          "fieldType": "object_list",
          "requirement": "publish",
          "requiresEvidence": true
        }
      ]
