            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "description": "当前用户会话的 CSRF 值",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "required": true,
            "description": "目标文件夹",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "URL 编码后的文件名",
            "schema": {
              "$ref": "#/components/schemas/Name"
            }
          },
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "description": "文件字节长度，必须准确。浏览器由传输层自动设置。",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
