  "components": {
    "securitySchemes": {
      "unifiedSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "由桌面统一出口转发的用户令牌；浏览器使用平台会话，不在页面持久保存令牌。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Entry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "folder"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mimeType": {
            "type": "string"
          },
          "preview": {
            "enum": [
              "image",
              "text",
              "pdf",
              "none"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "favorite": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "protected": {
            "enum": [
              "root",
              "desktop"
            ]
          },
          "accessedAt": {
            "type": "string",
            "format": "date-time"
          },
          "officeAccessedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "trashRootId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "parentId",
          "name",
          "kind",
          "size",
          "mimeType",
          "preview",
          "version",
          "favorite",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "FolderOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "folder"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mimeType": {
            "type": "string"
          },
          "preview": {
            "enum": [
              "image",
              "text",
              "pdf",
              "none"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "favorite": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "protected": {
            "enum": [
              "root",
              "desktop"
            ]
          },
          "accessedAt": {
            "type": "string",
            "format": "date-time"
          },
          "officeAccessedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "trashRootId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "parentId",
          "name",
          "kind",
          "size",
          "mimeType",
          "preview",
          "version",
          "favorite",
          "createdAt",
          "updatedAt",
          "label"
        ],
        "additionalProperties": false
      },
      "Quota": {
        "type": "object",
        "properties": {
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "maxFile": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "used",
          "limit",
          "maxFile"
        ]
      },
      "EntryPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "rootId": {
            "type": "string",
            "format": "uuid"
          },
          "desktopFolderId": {
            "type": "string",
            "format": "uuid"
          },
          "breadcrumbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          }
        },
        "required": [
          "items",
          "total",
          "parentId",
          "rootId",
          "desktopFolderId",
          "breadcrumbs",
          "quota"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "Name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180,
        "description": "去除首尾空白后非空；不能是 . 或 ..，不能包含路径分隔符、控制字符、<>:\"|?*，不能以点或空格结尾。"
      },
      "VersionInput": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "可选乐观锁版本；提供时必须与当前版本一致，否则返回 409。"
          }
        },
        "required": []
      },
      "PatchInput": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "favorite": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "可选乐观锁版本；提供时必须与当前版本一致，否则返回 409。"
          }
        },
        "required": []
      }
    }
  }
