    "/entries": {
      "get": {
        "operationId": "list",
        "summary": "查询文件",
        "responses": {
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无应用权限或 CSRF 校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务未完成请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPage"
                }
              }
            }
          }
        },
        "description": "仅返回当前账户的文件。recent 为文件应用访问历史；Office 独立打开历史由 Office 服务查询。文件夹优先，随后按指定字段排序。回收站只返回每次删除的根条目，配额包含回收站文件。",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "enum": [
                "files",
                "favorites",
                "recent",
                "trash"
              ],
              "default": "files"
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "required": false,
            "description": "默认根目录，也支持 desktop；所有视图均校验该文件夹归属。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "名称包含匹配，忽略大小写，去除首尾空白。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "默认 name；recent 默认 accessedAt。",
            "schema": {
              "enum": [
                "name",
                "size",
                "updatedAt",
                "accessedAt"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "description": "desc 为降序，其他值或省略为升序。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "最小按 1 处理。",
            "schema": {
              "type": "number",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "限制在 1～200 之间。",
            "schema": {
              "type": "number",
              "default": 100
            }
          }
        ]
      }
    },
