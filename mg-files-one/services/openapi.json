{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "个人文件服务",
    "version": "1.1.0",
    "description": "提供方 /api 相对路由。统一出口由平台绑定，调用使用当前用户身份；写请求须携带当前会话的 X-CSRF-Token。"
  },
  "x-service-id": "files.api",
  "x-app-id": "files",
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "unifiedSession": []
    }
  ],
  "paths": {
    "/auth/me": {
      "get": {
        "operationId": "me",
        "summary": "当前文件用户",
        "responses": {
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无应用权限或 CSRF 校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务未完成请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "username"
                  ]
                }
              }
            }
          }
        }
      }
    },
