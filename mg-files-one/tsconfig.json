{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@mg-inside/frontend": [
        "../mg-platform/packages/frontend/index.ts"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "@mg-inside/frontend/*": [
        "../mg-platform/packages/frontend/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "server/**/*.ts",
    "tests/server.test.ts"
  ]
}
