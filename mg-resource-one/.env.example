# 浏览器构建变量，生产静态文件由桌面域名的子路径提供。
VITE_APP_BASE=/apps/resource-manager/
VITE_DESKTOP_ORIGIN=https://desktop.meta-gravity.com
# 服务端专属；真实 secret 存于生产受限 EnvironmentFile，不提交到仓库。
IDENTITY_ENABLED=true
IDENTITY_ISSUER=https://identity.meta-gravity.com
IDENTITY_CLIENT_ID=resource-manager
IDENTITY_CLIENT_SECRET=由统一认证签发的独立服务客户端密钥
RESOURCE_HOST=127.0.0.1
RESOURCE_PORT=14370
RESOURCE_DATA_DIR=/opt/mg-resource/shared/data
RESOURCE_CREDENTIAL_DIR=/opt/mg-resource/shared/credentials
