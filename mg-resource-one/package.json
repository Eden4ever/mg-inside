  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vue-tsc": "3.0.6"
  }
}

