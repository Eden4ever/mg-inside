{
  "$schema": "../mg-platform/packages/frontend/config/application.schema.json",
  "schemaVersion": 1,
  "layout": "standard",
  "appId": "service-manager",
  "name": "服务管理",
  "defaultPath": "/services",
  "brand": {
    "name": "服务管理",
    "icon": "cable",
    "homePath": "/services"
  },
  "header": {
    "showTitle": true,
    "showBrand": true,
    "showAccount": true
  },
  "pages": [
    {
      "id": "services",
      "path": "/services",
      "title": "服务目录",
      "component": "services",
      "icon": "box"
    },
    {
      "id": "activity",
      "path": "/activity",
      "title": "统计分析",
      "component": "services",
      "icon": "clock"
    },
    {
      "id": "tags",
      "path": "/services/tags",
      "title": "标签管理",
      "component": "services",
      "icon": "layout-grid"
    },
    {
      "id": "register",
      "path": "/register",
      "title": "注册服务",
      "component": "services",
      "icon": "file-text"
    }
  ],
  "navigation": {
    "mode": "flat",
    "defaultCollapsed": true,
    "pageIds": [
      "services",
      "activity",
      "tags"
    ]
  },
  "browser": {
    "titleTemplate": "{title} · {name}"
  }
}
