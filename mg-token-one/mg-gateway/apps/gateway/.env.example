# ===== 服务 =====
NODE_ENV=development
# 生产发布编号，由发布脚本写入 UTC 时间戳（YYYYMMDDTHHMMSSZ）
MG_RELEASE_ID=development
MG_RELEASE_SHA256=development
PORT=3000
# 前端构建产物目录（管理/门户静态托管），开发期可为空
WEB_DIST_DIR=

# ===== 数据库（复用服务器 MySQL 8，新库 mg_gateway）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root_local_pwd
DB_DATABASE=mg_gateway
# 默认关闭；仅首次创建本地开发库时可临时设 true。生产环境禁止开启。
DB_SYNCHRONIZE=false

# ===== JWT（管理/门户登录态）=====
# 生产环境必须替换为至少 32 字符的随机密钥，否则服务拒绝启动。
JWT_SECRET=change-me-in-prod-32bytes-min
JWT_EXPIRES_IN=7d

# ===== 网关对外基址（写入文档/回调拼接）=====
GATEWAY_PUBLIC_URL=https://token.meta-gravity.com


# ===== 企业微信（自建应用，开"读取成员"权限）=====
WECOM_CORPID=
WECOM_AGENTID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 授权回调域名下的相对路径，默认 /api/auth/wecom/callback
WECOM_CALLBACK_PATH=/api/auth/wecom/callback
# 管理员白名单：命中则提升为 admin（只升不降）。格式 userid 或 部门ID，逗号分隔
WECOM_ADMIN_USERIDS=
WECOM_ADMIN_DEPTIDS=
# 新同步成员默认额度（统一 token 当量），0 表示跟随系统默认值
WECOM_DEFAULT_QUOTA=0

# ===== 转发 =====
# 每个请求最多尝试渠道数
RELAY_MAX_TRIES=3
# 是否按连续失败次数自动临时熔断渠道；生产环境必须为 false
AUTO_CIRCUIT_BREAKER_ENABLED=true
# 渠道连续失败禁用时长（秒）
CHANNEL_DISABLE_SECONDS=300
# 输出 token 折算比（completionTokens × 该值）
OUTPUT_RATIO=3
# 是否启用本地用量估算（上游不支持 usage 时）
ENABLE_LOCAL_USAGE_ESTIMATE=true

# ===== 调用记录保留 =====
# 调用记录按“当前 Asia/Shanghai 时刻减 3 个日历月”的截止时间清理；生产强制开启。
REQUEST_LOG_RETENTION_SCHEDULER_ENABLED=true
# 月末回退会钳位至目标月份的最后一天，并以 UTC instant 写入 MySQL。
REQUEST_LOG_RETENTION_MONTHS=3
# 单轮最多删除 10 x 1000 条，避免长事务和大范围锁定。
REQUEST_LOG_RETENTION_BATCH_SIZE=1000
REQUEST_LOG_RETENTION_MAX_BATCHES_PER_RUN=10
