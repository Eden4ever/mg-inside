{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "模型目录服务",
    "version": "1.2.0",
    "description": "Token 的两个只读模型目录，返回原始 {list}。能力字段反映后台配置，不保证实时路由健康、账户额度或 sk- 令牌调用权限。本批不登记 /v1 推理、计费或管理写接口。"
  },
  "x-service-id": "token-one.api",
  "x-app-id": "token-one",
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "unifiedSession": []
    }
  ],
  "paths": {
    "/portal/models": {
      "get": {
        "operationId": "portal-models",
        "summary": "查询当前账户可用模型",
        "description": "当前账户可见的启用模型，按模型 ID 升序。管理员可见全部；普通账户按用户分组与模型分组交集过滤，没有用户分组时使用 default。模型分组来自分组配置，旧 NULL 配置兼容 groupTag。返回空 list 表示没有可见模型。每次查询读取当前角色和分组，不信任浏览器提交的角色。上下文或输出限制 0 表示未标注；空模态配置默认 text。",
        "responses": {
          "200": {
            "description": "读取成功；不产生模型推理调用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountModels"
                }
              }
            }
          },
          "401": {
            "description": "未登录、身份无法验证或账户映射失败；公开提供方接口本身不要求登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "统一出口拒绝应用权限或来源",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "提供方未完成查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "统一出口无法连接提供方",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "身份服务不可用、服务未启用或提供方未配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/models": {
      "get": {
        "operationId": "models",
        "summary": "查询可用模型",
        "description": "公开能力目录，按模型 ID 升序返回全部启用模型；提供方原始 /api/public/models 允许匿名读取。经桌面统一出口时仍需平台会话及相应应用授权，文档入口的独立授权不因此扩大。公开响应不包含分组、价格、渠道绑定、备注或上游模型名。无分页、搜索或模型分组参数。",
        "responses": {
          "200": {
            "description": "读取成功；不产生模型推理调用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicModels"
                }
              }
            }
          },
          "401": {
            "description": "未登录、身份无法验证或账户映射失败；公开提供方接口本身不要求登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "统一出口拒绝应用权限或来源",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "提供方未完成查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "统一出口无法连接提供方",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "身份服务不可用、服务未启用或提供方未配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "PublicModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contextLength": {
            "type": "integer"
          },
          "maxOutputTokens": {
            "type": "integer"
          },
          "supportsVision": {
            "type": "boolean"
          },
          "supportsTools": {
            "type": "boolean"
          },
          "supportsReasoning": {
            "type": "boolean"
          },
          "supportsResponses": {
            "type": "boolean"
          },
          "supportsAnthropic": {
            "type": "boolean"
          },
          "reasoningEfforts": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputModalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputModalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "contextLength",
          "maxOutputTokens",
          "supportsVision",
          "supportsTools",
          "supportsReasoning",
          "supportsResponses",
          "supportsAnthropic",
          "reasoningEfforts",
          "inputModalities",
          "outputModalities"
        ],
        "additionalProperties": false
      },
      "AccountModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contextLength": {
            "type": "integer"
          },
          "maxOutputTokens": {
            "type": "integer"
          },
          "supportsVision": {
            "type": "boolean"
          },
          "supportsTools": {
            "type": "boolean"
          },
          "supportsReasoning": {
            "type": "boolean"
          },
          "supportsResponses": {
            "type": "boolean"
          },
          "supportsAnthropic": {
            "type": "boolean"
          },
          "reasoningEfforts": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputModalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputModalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groupTag": {
            "type": "string"
          },
          "remark": {
            "type": [
              "string",
              "null"
            ]
          },
          "visionNotes": {
            "type": [
              "string",
              "null"
            ]
          },
          "groupNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "contextLength",
          "maxOutputTokens",
          "supportsVision",
          "supportsTools",
          "supportsReasoning",
          "supportsResponses",
          "supportsAnthropic",
          "reasoningEfforts",
          "inputModalities",
          "outputModalities",
          "groupTag",
          "remark",
          "visionNotes",
          "groupNames"
        ],
        "additionalProperties": false
      },
      "PublicModels": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicModel"
            }
          }
        },
        "required": [
          "list"
        ],
        "additionalProperties": false
      },
      "AccountModels": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountModel"
            }
          }
        },
        "required": [
          "list"
        ],
        "additionalProperties": false
      },
      "GatewayError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "status_code": {
                "type": "integer",
                "minimum": 400,
                "maximum": 599
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "status_code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "OutletError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "Error": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/GatewayError"
          },
          {
            "$ref": "#/components/schemas/OutletError"
          }
        ]
      }
    },
    "securitySchemes": {
      "unifiedSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "统一出口转发当前用户身份，提供方校验 token-one 应用授权并读取本地角色和分组；不使用 sk- 推理令牌。"
      }
    }
  }
}
